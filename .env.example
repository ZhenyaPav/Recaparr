RECAPARR_API_TOKEN=replace-with-a-long-random-token
RECAPARR_LLM_API_KEY=sk-or-v1-replace-me
RECAPARR_LLM_BASE_URL=https://openrouter.ai/api/v1
RECAPARR_LLM_MODEL=deepseek/deepseek-v4-flash-latest
# RECAPARR_LLM_THINKING=none
RECAPARR_EAGER_GENERATION=true
RECAPARR_LAZY_GENERATION=true
RECAPARR_PREFERRED_SUBTITLE_LANGUAGE=en
RECAPARR_SUMMARY_LANGUAGE=en
JELLYFIN_URL=http://jellyfin:8096
JELLYFIN_API_KEY=replace-with-jellyfin-api-key
# Optional but recommended; Recaparr otherwise selects an enabled Jellyfin user.
# JELLYFIN_USER_ID=replace-with-jellyfin-user-id

# Optional overrides
# RECAPARR_PORT=8080
# RECAPARR_DATABASE_PATH=/data/recaparr.sqlite
# RECAPARR_MEDIA_ROOT=/media
# RECAPARR_ARR_PATH_PREFIX=/downloads
# RECAPARR_JELLYFIN_PATH_PREFIX=/data
# RECAPARR_RETRY_DELAYS_MINUTES=5,30,120,480,1440
# RECAPARR_GENERATION_TIMEOUT_MS=600000
# RECAPARR_LOG_LEVEL=info
